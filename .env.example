# Archivo de configuración de variables de entorno
PORT=5000

# Cadena de conexión a MongoDB (MongoDB Atlas o local)
# Ejemplo con MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/slackws_db?retryWrites=true&w=majority
# Ejemplo con MongoDB Local:
# MONGODB_URI=mongodb://localhost:27017/slackws_db
MONGODB_URI=
